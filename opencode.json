{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/muse-spark-1.3-contributor",
  "default_agent": "executor-brk-01",
  "enabled_providers": [
    "opencode-go"
  ],
  "share": "disabled",
  "snapshot": true,
  "autoupdate": false,
  "formatter": true,
  "lsp": true,
  "tools": {
    "task": false,
    "webfetch": false,
    "websearch": false,
    "todowrite": false
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "tool_output": {
    "max_lines": 180,
    "max_bytes": 16000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "target/**",
      ".git/**",
      "coverage/**",
      "*.db",
      "*.db-wal",
      "*.db-shm",
      "*.log"
    ]
  },
  "provider": {
    "opencode-go": {
      "options": {},
      "models": {
        "muse-spark-1.3-contributor": {
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },
    "edit": {
      "*": "allow",
      "**/*.db": "deny",
      "**/*.db-wal": "deny",
      "**/*.db-shm": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "skill": {
      "*": "deny",
      "baraka-*": "allow"
    },
    "lsp": "allow",
    "question": "deny",
    "task": "deny",
    "external_directory": "deny",
    "websearch": "deny",
    "webfetch": "deny",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "pwd*": "allow",
      "ls*": "allow",
      "dir*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch --show-current*": "allow",
      "git rev-parse --show-toplevel*": "allow",
      "git diff --check*": "allow",
      "git diff --name-only*": "allow",
      "git diff --stat*": "allow",
      "rg *": "allow",
      "npx tsc --noEmit*": "allow",
      "npm run build --if-present*": "allow",
      "npm run build*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run check*": "allow",
      "npx vitest*": "allow",
      "npx eslint*": "allow",
      "npx prettier*": "allow",
      "cargo check*": "allow",
      "cargo test*": "allow",
      "cargo fmt --check*": "allow",
      "cargo clippy*": "allow",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git clean -fd*": "deny",
      "rm -rf *": "deny",
      "rm -f baraka.db*": "deny",
      "rm baraka.db*": "deny",
      "shred *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sftp *": "deny"
    }
  },
  "instructions": [
    "./AGENTS.md"
  ],
  "mcp": {},
  "plugin": [],
  "agent": {
    "executor-brk-01": {
      "description": "Baraka UltraPOS production executor. Executes exactly one TASK-BRK-XXX within the declared scope and reports deterministic verification results.",
      "mode": "primary",
      "model": "opencode-go/muse-spark-1.3-contributor#high",
      "prompt": "{file:./CONSTITUTION_OF_EXECUTOR.md}"
    }
  }
}
