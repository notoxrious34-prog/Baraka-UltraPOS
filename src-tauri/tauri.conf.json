{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baraka UltraPOS",
  "version": "1.2.0",
  "identifier": "com.baraka.ultrapos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Baraka UltraPOS",
        "create": false,
        "width": 1280,
        "height": 640,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'self'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": {
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/notoxrious34-prog/Baraka-UltraPOS/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3OUZCQkUyMjVDNzlCQUEKUldTcW04Y2w0cnVmdDZYQXBMS21xS2huNFg4ZnRqRG1vcmlzbDI5ejZRUFB1cisxclVNWEJUbm0K"
    }
  }
}
